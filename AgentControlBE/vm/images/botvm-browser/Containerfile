# syntax=docker/dockerfile:1
# BE-P2-3: agentcontrol/botvm-browser — the shared, read-only browser layer
# (plan §2.2, §9). FROM the botvm base plus Playwright and headless Chromium.
# Used only by bots whose Browser permission is on; never counted in a bot's 10 GB.
# Chromium runs headless with --no-sandbox (the container is the sandbox).
# Browsers live read-only in /opt/ms-playwright; downloads into volumes are blocked.

ARG BOTVM_IMAGE=localhost/agentcontrol/botvm:1.0.0
FROM ${BOTVM_IMAGE}

ARG BOTVM_VERSION=1.0.0
ARG PLAYWRIGHT_VERSION=1.64.1

LABEL org.opencontainers.image.title="agentcontrol/botvm-browser" \
      org.opencontainers.image.description="AgentControl bot VM browser layer: botvm + Playwright + headless Chromium" \
      org.opencontainers.image.version="${BOTVM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.agentcontrol.image="botvm-browser" \
      io.agentcontrol.version="${BOTVM_VERSION}" \
      io.agentcontrol.playwright="${PLAYWRIGHT_VERSION}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Installing system packages needs root; the final USER drops back to 1000.
USER root

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Playwright for Python (system site-packages, not the bot's --user dir) and Node
# (global under /usr/local), same version so both use the one Chromium build.
RUN PIP_USER=0 pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" \
 && NPM_CONFIG_PREFIX=/usr/local npm install -g --no-fund --no-audit "playwright@${PLAYWRIGHT_VERSION}" \
 && python3 -m playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.cache /root/.npm \
 && chmod -R a+rX "${PLAYWRIGHT_BROWSERS_PATH}"

# Node resolves the global playwright; no further browser downloads (rootfs is
# read-only at run time, and volumes must not hold browsers).
ENV NODE_PATH=/home/bot/.local/lib/node_modules:/usr/local/lib/node_modules \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_CHROMIUM_ARGS=--no-sandbox \
    AC_BOTVM_BROWSER=1

USER 1000:1000
WORKDIR /bot/workspace

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
