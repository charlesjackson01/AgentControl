# syntax=docker/dockerfile:1
# BE-P2-3: agentcontrol/botvm — the shared, read-only base every bot container
# starts from (plan §2.2). Debian slim, Python 3.12, Node 22, coreutils, uid 1000.
# Never modified by bots: per-bot apt packages go in localhost/ac-bot-<slug>:<gen>
# (BE-P2-4), pip/npm installs land in the bot's ac-tools volume at /home/bot.
# Build with vm/build-images.sh (versions from vm/images/versions.env).

ARG BASE_IMAGE=docker.io/library/python:3.12.16-slim-bookworm@sha256:6dd8b6dab6b3adc7812bab69eca5dbdc1a5cc690ad28306d234ffb4ef8ac9753
FROM ${BASE_IMAGE}

ARG BOTVM_VERSION=1.0.0
ARG PYTHON_VERSION=3.12.16
ARG NODE_VERSION=22.23.4
ARG NODE_SHA256_X64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
ARG NODE_SHA256_ARM64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
ARG TARGETARCH

LABEL org.opencontainers.image.title="agentcontrol/botvm" \
      org.opencontainers.image.description="AgentControl bot VM base: Debian slim, Python 3.12, Node 22, uid 1000" \
      org.opencontainers.image.version="${BOTVM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.agentcontrol.image="botvm" \
      io.agentcontrol.version="${BOTVM_VERSION}" \
      io.agentcontrol.python="${PYTHON_VERSION}" \
      io.agentcontrol.node="${NODE_VERSION}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# System tools. No sudo, no ssh server, no compilers beyond what pip wheels need.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates coreutils findutils procps tini xz-utils curl git jq less unzip zip file \
 && rm -rf /var/lib/apt/lists/*

# Node 22 from the official tarball, checksum-verified per architecture.
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64|x86_64) arch=x64; sum="${NODE_SHA256_X64}" ;; \
      arm64|aarch64) arch=arm64; sum="${NODE_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" \
 && echo "${sum}  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
      --exclude='*/CHANGELOG.md' --exclude='*/README.md' --exclude='*/LICENSE' \
 && rm /tmp/node.tar.xz \
 && node --version && npm --version && python3 --version

# Non-root bot user (uid/gid 1000) and the /bot layout (plan §2.2):
#   /bot/workspace (rw), /bot/shared (ro inputs), /bot/skills (ro),
#   /bot/groups/<g> (rw group shares), /home/bot (ac-tools volume),
#   /opt/bot (ac-opt volume, /opt/bot/bin on PATH). /tmp is a tmpfs at run time.
RUN groupadd --gid 1000 bot \
 && useradd --uid 1000 --gid 1000 --home-dir /home/bot --create-home --shell /bin/bash bot \
 && mkdir -p /bot/workspace /bot/shared /bot/skills /bot/groups /opt/bot/bin /home/bot/.local/bin \
 && chown -R 1000:1000 /bot/workspace /bot/groups /opt/bot /home/bot \
 && chmod 0755 /bot /bot/shared /bot/skills

ENV LANG=C.UTF-8 \
    HOME=/home/bot \
    PATH=/home/bot/.local/bin:/opt/bot/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PIP_USER=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUSERBASE=/home/bot/.local \
    PYTHONUNBUFFERED=1 \
    NPM_CONFIG_PREFIX=/home/bot/.local \
    NODE_PATH=/home/bot/.local/lib/node_modules \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    AC_BOTVM_VERSION=${BOTVM_VERSION}

USER 1000:1000
WORKDIR /bot/workspace

# The container is persistent and idle between runs; runs arrive via `podman exec`.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
