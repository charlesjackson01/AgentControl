# Copy to .env.local (gitignored) and fill in what you need. All optional.

# Override the API base. Leave empty to use the relative /api proxy.
VITE_API_BASE=

# Bearer token sent as `Authorization: Bearer <token>`; must match the BE's
# AGENTCONTROL_AUTH_TOKEN. Embedded in the bundle at build time.
VITE_AUTH_TOKEN=

# Where the dev/preview proxy forwards /api (config-only, not in the bundle).
# Defaults to http://localhost:3001.
AGENTCONTROL_API_TARGET=
