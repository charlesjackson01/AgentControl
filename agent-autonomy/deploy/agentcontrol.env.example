# AgentControl settings for the systemd user services (read by both services).
# After editing:  systemctl --user restart agentcontrol
# Flags are split on spaces, so paths must not contain spaces.
AGENTCONTROL_ARGS="--host @HOST@ --port 8766 --project @PROJECT@ --opencode http://127.0.0.1:@OC_PORT@ --profile ai-arch-dev --research-toolsets web@VM_ARGS@"
# Services start with a minimal PATH; this one was taken from your shell at install time so that
# hermes, opencode, podman and virsh are found. Update it if you install tools elsewhere.
PATH="@PATH@"
# Optional: protect the OpenCode API with a password (used by both services).
#OPENCODE_SERVER_PASSWORD=
