# AgentControl dashboard (systemd user service).
# Rendered by install-user-services.sh; your flags live in ~/.config/agentcontrol/agentcontrol.env.
[Unit]
Description=AgentControl dashboard
Wants=agentcontrol-opencode.service
After=agentcontrol-opencode.service network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=%h/.config/agentcontrol/agentcontrol.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ @REPO@/agent-autonomy/app.py $AGENTCONTROL_ARGS
# Also covers a Tailscale address that is not up yet right after boot.
Restart=on-failure
RestartSec=10
# app.py stops cleanly on SIGTERM; a submitted OpenCode task is reconciled on the next Resume.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
