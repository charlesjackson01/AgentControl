# /etc/systemd/system/cf-tunnel-direct-route.service
#
# Cloudflare Tunnel (cloudflared) direct-route bypass.
#
# Why: this node uses a Tailscale exit node for all egress (table 52,
# default dev tailscale0, rule 5270). That exit path blackholes
# Cloudflare edge ranges (observed: 198.41.0.0/16, 141.101.64.0/18),
# so cloudflared's QUIC dials to port 7844 time out and the tunnel
# drops to readyConnections=0 -> Cloudflare Error 1033 on public
# hostnames. The local ISP route (enp4s0) reaches those ranges fine.
#
# These rules force Cloudflare edge traffic to the normal ISP route
# (lookup main) at priority 5010, which is evaluated BEFORE
# tailscale's 5210-5270 rule block, and is NOT managed/removed by
# tailscaled. Everything else keeps using the exit node.
#
# Ranges: Cloudflare anycast + argus edge space.
#   198.41.0.0/16  (argus tunnel edge, :7844 quic)
#   172.64.0.0/13, 104.16.0.0/12, 188.114.96.0/20,
#   141.101.0.0/16, 173.245.48.0/20, 108.162.192.0/18,
#   128.242.240.0/20  (CF anycast)
#
# Added 2026-08-29 after diagnosing Error 1033.

[Unit]
Description=Direct-route bypass for Cloudflare edge IPs (tunnel fix)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/sbin/ip rule del priority 5010 to 198.41.0.0/16 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 198.41.0.0/16 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 172.64.0.0/13 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 172.64.0.0/13 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 141.101.0.0/16 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 141.101.0.0/16 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 188.114.96.0/20 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 188.114.96.0/20 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 104.16.0.0/12 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 104.16.0.0/12 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 173.245.48.0/20 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 173.245.48.0/20 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 108.162.192.0/18 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 108.162.192.0/18 lookup main
ExecStart=/usr/sbin/ip rule del priority 5010 to 128.242.240.0/20 lookup main
ExecStart=/usr/sbin/ip rule add priority 5010 to 128.242.240.0/20 lookup main

[Install]
WantedBy=multi-user.target
