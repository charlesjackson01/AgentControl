<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.aiarch.Config — configd (docs/AI-ARCHITECTURE.md §4.1) -->
<node>
  <interface name="org.aiarch.Config">
    <property name="AiEnabled" type="b" access="read" emit="true"/>
    <property name="EndpointUrl" type="s" access="read" emit="true"/>
    <property name="Model" type="s" access="read" emit="true"/>
    <property name="ApiKeyRef" type="s" access="read" emit="true"/>
    <property name="TimeoutMs" type="u" access="read" emit="true"/>
    <property name="MaxTokensDefault" type="u" access="read" emit="true"/>
    <property name="PreferLocal" type="b" access="read" emit="true"/>
    <property name="LogRetentionDays" type="i" access="read" emit="true"/>
    <property name="ContentLogging" type="b" access="read" emit="true"/>
    <property name="ExcludedPaths" type="as" access="read" emit="true"/>
    <property name="PermDefaultReadonly" type="s" access="read" emit="true"/>
    <property name="PermDefaultLow" type="s" access="read" emit="true"/>
    <property name="PermDefaultSensitive" type="s" access="read" emit="true"/>
    <property name="PermDefaultCritical" type="s" access="read" emit="true"/>
    <property name="Version" type="i" access="read" emit="true"/>

    <method name="SetAiEnabled">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="SetEndpoint">
      <arg name="url" type="s" direction="in"/>
      <arg name="model" type="s" direction="in"/>
    </method>
    <method name="SetApiKey">
      <arg name="key" type="s" direction="in"/>
    </method>
    <method name="SetPrivacy">
      <arg name="section" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="SetPermissionDefault">
      <arg name="class" type="s" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="TestEndpoint">
      <!-- (i result, s model, i latency_ms) — 0 = ok, 1 = unreachable, 2 = not configured -->
      <arg name="result" type="i" direction="out"/>
      <arg name="model" type="s" direction="out"/>
      <arg name="latency_ms" type="i" direction="out"/>
    </method>

    <signal name="Changed"/>
    <signal name="ChangedSection">
      <arg name="section" type="s"/>
    </signal>
    <signal name="FileReplaced">
      <arg name="path" type="s"/>
    </signal>
  </interface>
</node>
