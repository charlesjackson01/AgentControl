<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.aiarch.Rag — ragd (docs/AI-ARCHITECTURE.md §4.6).
     Stage E contract: not implemented in the Stage D build. -->
<node>
  <interface name="org.aiarch.Rag">
    <method name="List">
      <arg name="datasets" type="a{sv}" direction="out"/>
    </method>
    <method name="Create">
      <arg name="name" type="s" direction="in"/>
    </method>
    <method name="Remove">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="AddDocuments">
      <arg name="id" type="s" direction="in"/>
      <arg name="paths" type="as" direction="in"/>
      <arg name="job_id" type="s" direction="out"/>
    </method>
    <method name="RemoveDocument">
      <arg name="id" type="s" direction="in"/>
      <arg name="path" type="s" direction="in"/>
    </method>
    <method name="Reindex">
      <arg name="id" type="s" direction="in"/>
      <arg name="job_id" type="s" direction="out"/>
    </method>
    <method name="Query">
      <arg name="id" type="s" direction="in"/>
      <arg name="q" type="s" direction="in"/>
      <arg name="k" type="i" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>

    <signal name="DatasetUpdated">
      <arg name="id" type="s"/>
    </signal>
    <signal name="IndexProgress">
      <arg name="job_id" type="s"/>
      <arg name="pct" type="i"/>
    </signal>
  </interface>
</node>
